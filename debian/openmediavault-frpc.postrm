# any later version.

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

remove_action() {
	# Remove the systemd unit file generated by the Salt state.
	echo "Removing systemd unit file ..."
	rm -f /etc/systemd/system/frpc.service
	systemctl --system daemon-reload || true
	# Activate trigger to rebuild workbench configuration files.
	dpkg-trigger update-workbench
}

case "$1" in
	purge)
		remove_action
		echo "Cleaning up configuration database ..."
		omv_config_delete "/config/services/frpc"
		# Remove the native backend configuration. A Docker bind-mount
		# path (configurable) is never deleted here.
		rm -f /etc/frp/frpc.toml
		rmdir /etc/frp 2>/dev/null || true
	;;

	remove)
		remove_action
	;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0

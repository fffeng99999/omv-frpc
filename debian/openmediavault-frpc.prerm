set -e

case "$1" in
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	remove)
		# Stop the native service if it exists. A Docker container
		# managed by the user is intentionally never touched.
		deb-systemd-invoke stop frpc.service 2>/dev/null || true
		deb-systemd-helper disable frpc.service 2>/dev/null || true
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0

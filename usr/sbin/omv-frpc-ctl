#!/bin/sh
#
# This file is part of OpenMediaVault.
#
# @license   https://www.gnu.org/licenses/gpl.html GPL Version 3
# @author    ${GITHUB_USER}
#
# Backend-agnostic control helper for the openmediavault-frpc plugin.
# It is called by the engined RPC service and by the Salt state.
#
# Usage:
#   omv-frpc-ctl <op> <backend> [container] [containerConfigPath] \
#                [hostConfigPath]
#
#   <op>       is-active|start|stop|restart|reload|version|logs|showconfig
#   <backend>  docker|native
#
# The native backend uses the bundled /usr/bin/frpc and the systemd unit
# frpc.service. The docker backend controls an existing frpc container
# (created e.g. via Compose); the plugin never creates or removes it.

set -u

OP="${1:-}"
BACKEND="${2:-}"
CONTAINER="${3:-frpc}"
CONTAINER_CFG="${4:-/etc/frp/frpc.toml}"
HOST_CFG="${5:-/etc/frp/frpc.toml}"

NATIVE_BIN="/usr/bin/frpc"
NATIVE_CFG="/etc/frp/frpc.toml"

if [ "$#" -lt 2 ]; then
	echo "Usage: $0 <op> <docker|native> [container] [containerConfigPath] [hostConfigPath]" >&2
	exit 2
fi

case "$BACKEND" in
	docker|native) ;;
	*)
		echo "Unknown backend: $BACKEND" >&2
		exit 2
		;;
esac

docker_container_exists() {
	docker inspect --type=container -- "$CONTAINER" >/dev/null 2>&1
}

docker_is_active() {
	if docker_container_exists; then
		[ "$(docker inspect -f '{{.State.Running}}' -- "$CONTAINER" 2>/dev/null)" = "true" ]
	else
		return 1
	fi
}

native_is_active() {
	systemctl is-active --quiet frpc.service
}

case "$OP" in
	is-active)
		if [ "$BACKEND" = "docker" ]; then
			if docker_is_active; then
				echo "running"
			else
				echo "stopped"
			fi
		else
			if native_is_active; then
				echo "running"
			else
				echo "stopped"
			fi
		fi
		exit 0
		;;

	start)
		if [ "$BACKEND" = "docker" ]; then
			if ! docker_container_exists; then
				echo "Docker container '$CONTAINER' does not exist." >&2
				exit 1
			fi
			docker start -- "$CONTAINER" >/dev/null
			# Keep the container running across host reboots unless the
			# user disables the service (stop sets restart policy back).
			docker update --restart=unless-stopped -- "$CONTAINER" >/dev/null 2>&1 || true
		else
			systemctl start frpc.service
		fi
		;;

	stop)
		if [ "$BACKEND" = "docker" ]; then
			if docker_container_exists; then
				docker update --restart=no -- "$CONTAINER" >/dev/null 2>&1 || true
				docker stop -- "$CONTAINER" >/dev/null 2>&1 || true
			fi
		else
			systemctl stop frpc.service
		fi
		;;

	restart)
		if [ "$BACKEND" = "docker" ]; then
			if ! docker_container_exists; then
				echo "Docker container '$CONTAINER' does not exist." >&2
				exit 1
			fi
			docker restart -- "$CONTAINER" >/dev/null
		else
			systemctl restart frpc.service
		fi
		;;

	reload)
		# frpc hot-reloads through its own admin (webServer) API. The
		# webServer must be enabled for this to work; otherwise use
		# restart which does not require the admin listener.
		if [ "$BACKEND" = "docker" ]; then
			if ! docker_is_active; then
				echo "Docker container '$CONTAINER' is not running." >&2
				exit 1
			fi
			docker exec -- "$CONTAINER" /usr/bin/frpc reload -c "$CONTAINER_CFG"
		else
			if [ ! -x "$NATIVE_BIN" ]; then
				echo "frpc binary not found at $NATIVE_BIN" >&2
				exit 1
			fi
			"$NATIVE_BIN" reload -c "$NATIVE_CFG"
		fi
		;;

	version)
		if [ "$BACKEND" = "docker" ]; then
			if docker_is_active; then
				docker exec -- "$CONTAINER" /usr/bin/frpc -v 2>/dev/null
			else
				# fall back to the image metadata when stopped
				docker image inspect -f '{{.Config.Image}}' -- "$CONTAINER" >/dev/null 2>&1 || true
				echo ""
			fi
		else
			if [ -x "$NATIVE_BIN" ]; then
				"$NATIVE_BIN" -v 2>/dev/null
			fi
		fi
		;;

	logs)
		if [ "$BACKEND" = "docker" ]; then
			if ! docker_container_exists; then
				echo "Docker container '$CONTAINER' does not exist." >&2
				exit 1
			fi
			echo "===== docker logs --tail 200 $CONTAINER ====="
			docker logs --tail 200 --timestamps -- "$CONTAINER" 2>&1 || true
		else
			echo "===== journalctl -u frpc -n 200 ====="
			journalctl -u frpc.service -n 200 --no-pager 2>&1 || true
		fi
		;;

	showconfig)
		echo "===== $HOST_CFG (generated by openmediavault-frpc) ====="
		if [ -f "$HOST_CFG" ]; then
			cat "$HOST_CFG"
		else
			echo "The configuration file has not been generated yet."
			echo "Save the settings and click 'Apply' to deploy."
		fi
		;;

	*)
		echo "Unknown operation: $OP" >&2
		exit 2
		;;
esac

exit 0
